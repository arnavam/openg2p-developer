# Optional interpreter for all Python venvs (e.g. python3.13). Default: python3 on PATH.
# OPENG2P_PYTHON=python3.12

# Where OpenG2P product repos are cloned.
# Must be a dedicated directory (default: sibling folder openg2p-workspace).
# Do NOT use ".." alone — repos would land in the parent of this repo.
OPENG2P_WORKSPACE=../openg2p-workspace

# Reusing repos that already live alongside openg2p-developer? Either set
# OPENG2P_WORKSPACE=.. or symlink them into the workspace folder:
#   cd ../openg2p-workspace
#   ln -sf ../registry-platform .
#   ln -sf ../iam-service .
#   ln -sf ../master-data-service .
#   ln -sf ../farmer-registry .
#   ln -sf ../national-social-registry .
#   ln -sf ../awe .

# Default clone profile for `make setup` / `make clone` when PROFILE is not passed.
# Options: registry | national-social-registry | farmer-registry | pbms | bridge | spar | full | infra
SETUP_PROFILE=registry

# Path to Odoo 17 source (cloned by `make clone PROFILE=pbms`; shallow 17.0 branch only)
ODOO_PATH=../openg2p-workspace/odoo17

# OpenG2P PBMS monorepo (Odoo modules under pbms/odoo/, extensions under pbms/odoo/extensions/)
PBMS_PATH=../openg2p-workspace/pbms

# Shared infrastructure (docker compose defaults)
# Use 5433 if you already have a local Postgres on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=localhost
# When USE_EXTERNAL_REDIS=true, point at your existing Redis (usually 6379).
# When USE_EXTERNAL_REDIS=false, set REDIS_PORT=6380 if Docker cannot bind 6379.
REDIS_PORT=6379
# Redis DB index for PBMS Celery (registry uses /0; keep separate to avoid beat task cross-talk)
PBMS_REDIS_DB=1
# Skip Docker Redis and use an existing local Redis on REDIS_HOST:REDIS_PORT instead.
# Docker-only Farmer/NSR (`make docker-farmer-up` / `make docker-nsr-up`) requires USE_EXTERNAL_REDIS=false.
USE_EXTERNAL_REDIS=true

MINIO_API_PORT=9000
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminsecret

KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=staff
KEYCLOAK_IAM_CLIENT_SECRET=dev-iam-staff-secret
KEYCLOAK_DEV_USER=staff
KEYCLOAK_DEV_PASSWORD=staff
# AWE Stage 1/2 demo approvers (alex.carter / nina.patel)
KEYCLOAK_AWE_APPROVER_PASSWORD=pass

# IAM Staff Portal API (SSO broker for registry UI login)
IAM_STAFF_PORT=8020

# Hub Staff Portal UI (app launcher with links to Farmer / NSR / …)
STAFF_PORTAL_UI_PORT=3000

# Approval Workflow Engine (AWE) — CR + intake approval flows
AWE_API_PORT=8030
AWE_UI_PORT=8031
KEYCLOAK_AWE_RESOLVER_CLIENT_SECRET=dev-awe-resolver-secret
AWE_REGISTRY_CALLBACK_SECRET_ID=00000000-0000-4000-8000-000000000001
AWE_REGISTRY_CALLBACK_HMAC_SECRET=dev-registry-awe-callback-secret

# OpenG2P ID Generator — functional / registry IDs (Docker, started with make infra-up)
ID_GENERATOR_PORT=8040
# ID_GENERATOR_IMAGE=openg2p/openg2p-id-generator:1.0.0

# Master Data API (geo / reference data; Docker Farmer/NSR stacks)
MASTER_DATA_API_PORT=8042
NSR_MASTER_DATA_API_PORT=8043

# Application ports (native/hybrid mode)
PBMS_HTTP_PORT=8069
PBMS_STAFF_API_PORT=8050

# PBMS background tasks read registrant data from a social registry DB.
# farmer-registry is the default local stack; set national-social-registry for NSR.
PBMS_REGISTRY_VARIANT=farmer-registry
PBMS_WITH_REGISTRY=true
# PBMS_BGTASK_DB_NAME=bgtaskdb

# Registry Gen2: Farmer Registry
FARMER_REGISTRY_STAFF_API_PORT=8001
FARMER_REGISTRY_PARTNER_API_PORT=8006
FARMER_REGISTRY_UI_PORT=3001
FARMER_REGISTRY_UI_PATH=../openg2p-workspace/registry-platform/ui/staff-ui

# Registry Gen2: National Social Registry
NSR_REGISTRY_STAFF_API_PORT=8011
NSR_REGISTRY_PARTNER_API_PORT=8012
NSR_REGISTRY_UI_PORT=3002
NSR_REGISTRY_UI_PATH=../openg2p-workspace/registry-platform/ui/staff-ui

# Registry staff API JWT validation (false avoids dashboard login reload loops in local dev)
REGISTRY_AUTH_ENABLED=false

# Registry seed options (used by make farmer-setup, make nsr-setup, and *-registry-seed)
# LOAD_SAMPLE_DATA=false
# LOAD_IMAGES=false
# LOAD_TEMPLATES=false
# OPENG2P_DATA_DIR=../openg2p-workspace/openg2p-data

G2P_BRIDGE_API_PORT=8002
G2P_BRIDGE_EXAMPLE_BANK_PORT=8003
SPAR_MAPPER_API_PORT=8004
SPAR_BENE_API_PORT=8005
# Redis DB indices: registry=0, PBMS Celery=1, Bridge Celery=2, example bank=3
G2P_BRIDGE_REDIS_DB=2
EXAMPLE_BANK_REDIS_DB=3
PBMS_WITH_BRIDGE=true
PBMS_WITH_SPAR=true
# PBMS Celery uses local JWS signing for Bridge calls (test key from g2p-bridge repo).
PBMS_SIGNING_KEY_PATH=
PBMS_SIGNING_KEY_PASSWORD=testpartner
SPAR_AUTO_SEED_FARMER_LINKS=true

# Git branch/tag pins (override versions.yaml if needed)
# IAM + AWE + Master Data: develop; Farmer 1.3; NSR 1.1; Registry Platform 1.2
PBMS_REF=develop
REGISTRY_REF=1.2
IAM_REF=develop
MASTER_DATA_REF=develop
FARMER_REGISTRY_REF=1.3
NSR_REF=1.1
G2P_BRIDGE_REF=develop
SPAR_REF=develop
AWE_REF=develop
ODOO_REF=17.0
# Master Data country pack under openg2p-data/packs (XKM = Kamuntu demo)
MASTER_DATA_COUNTRY_PACK=XKM

# BEGIN IMAGE PINS (managed by make sync-images)
# Sourced from versions.yaml — do not hand-edit; run: make sync-images
STAFF_PORTAL_UI_IMAGE=openg2p/openg2p-staff-portal-ui:0.0.0-develop.54
REGISTRY_STAFF_PORTAL_UI_IMAGE=openg2p/openg2p-registry-staff-portal-ui:1.1.1
IAM_STAFF_PORTAL_API_IMAGE=openg2p/iam-staff-portal-api:1.3.0
MASTER_DATA_API_IMAGE=openg2p/openg2p-gen2-master-data-api:1.0.1
AWE_API_IMAGE=openg2p/openg2p-awe:1.2.0
AWE_UI_IMAGE=openg2p/openg2p-awe-ui:1.2.0
FARMER_REGISTRY_STAFF_API_IMAGE=openg2p/openg2p-farmer-registry-staff-api:1.2.0
FARMER_REGISTRY_PARTNER_API_IMAGE=openg2p/openg2p-farmer-registry-partner-api:1.2.0
FARMER_REGISTRY_CELERY_IMAGE=openg2p/openg2p-farmer-registry-celery:1.2.0
FARMER_REGISTRY_DB_SEED_IMAGE=openg2p/openg2p-farmer-registry-db-seed:1.2.0
NSR_REGISTRY_STAFF_API_IMAGE=openg2p/openg2p-nsr-staff-api:1.0.1
NSR_REGISTRY_PARTNER_API_IMAGE=openg2p/openg2p-nsr-partner-api:1.0.1
NSR_REGISTRY_CELERY_IMAGE=openg2p/openg2p-nsr-celery:1.0.1
NSR_REGISTRY_DB_SEED_IMAGE=openg2p/openg2p-nsr-db-seed:1.0.1
ID_GENERATOR_IMAGE=openg2p/openg2p-id-generator:1.0.0
PBMS_IMAGE=openg2p/openg2p-pbms-core:develop
# END IMAGE PINS
