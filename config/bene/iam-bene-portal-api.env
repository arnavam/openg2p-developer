IAM_BENE_APP_HOST="0.0.0.0"
IAM_BENE_APP_PORT=8000

IAM_BENE_AUTH_REDIS_URL="redis://redis:6379/2"
IAM_BENE_AUTH_TRANSACTION_STORE_BACKEND=redis

IAM_BENE_DB_DRIVER=postgresql+asyncpg
IAM_BENE_DB_HOSTNAME="postgres"
IAM_BENE_DB_USERNAME=postgres
IAM_BENE_DB_PASSWORD="postgres"
IAM_BENE_DB_DBNAME=iam_bene
IAM_BENE_DB_PORT=5432

IAM_BENE_OPENAPI_ROOT_PATH=/
IAM_BENE_AUTH_ENABLED=true
IAM_BENE_AUTH_COOKIE_HTTPONLY=true
IAM_BENE_AUTH_COOKIE_PATH=/
IAM_BENE_AUTH_COOKIE_DOMAIN=localhost
IAM_BENE_AUTH_COOKIE_MAX_AGE=1800
IAM_BENE_AUTH_COOKIE_SET_EXPIRES=true
IAM_BENE_AUTH_COOKIE_SECURE=false

IAM_BENE_CORS_ALLOW_ORIGINS='["*"]'
